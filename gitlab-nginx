#
# !!! DO NOT REMOVE THE ROOT CHECK !!!
# !!! CALL IT EARLY AND OFTEN !!!
# =============================================================================

ensure_letsencrypt_structure() {
    if [ "$(id -u)" -ne 0 ]; then
        return 0
    fi

    mkdir -p /etc/letsencrypt \
            /etc/letsencrypt/renewal \
            /etc/letsencrypt/live \
            /etc/letsencrypt/archive 2>/dev/null || true

    if [ ! -f "$EMAIL_FILE" ]; then
        touch "$EMAIL_FILE" 2>/dev/null || true
        chmod 600 "$EMAIL_FILE" 2>/dev/null || true
    fi

    if [ ! -f "$DOMAINS_FILE" ]; then
        touch "$DOMAINS_FILE" 2>/dev/null || true
        chmod 644 "$DOMAINS_FILE" 2>/dev/null || true
    fi
}


# =============================================================================
# create_nginx_adm_user() - Create dedicated least-privilege user (NEW 1.9.0)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF nginx-adm LEAST-PRIVILEGE MODEL
#
# Purpose:
#   Creates the "nginx-adm" user if it does not exist.
#   This user will own all nginx configuration and will be used for day-to-day operations.
#
# Rules:
#   • User is a normal (non-root) system user.
#   • Home directory is set to /etc/nginx-adm (not under /home).
#   • Shell is /bin/bash.
#   • Group "nginx-adm" is also created.
#   • Idempotent: does nothing if user already exists.
#   • Fixed UID = 1999, GID = 1999
#
# !!! MUST BE CALLED EARLY IN BOTH INTERACTIVE AND NON-INTERACTIVE SETUP !!!
# =============================================================================

create_nginx_adm_user() {
    info "Setting up nginx-adm user (UID/GID 1999)..."

    # Create group with fixed GID if it doesn't exist
    if ! getent group nginx-adm >/dev/null 2>&1; then
        groupadd -g 1999 nginx-adm 2>/dev/null || true
    fi

    # Create user if it doesn't exist
    if ! id "nginx-adm" >/dev/null 2>&1; then
        useradd -m -d /etc/nginx-adm \
                -g 1999 -u 1999 \
                -s /bin/bash \
                -c "Admin user for nginx configuration" \
                nginx-adm 2>/dev/null || true
    else
        info "nginx-adm user already exists."
    fi

    # Ensure home directory exists and has correct ownership
    mkdir -p /etc/nginx-adm 2>/dev/null || true
    chown nginx-adm:nginx-adm /etc/nginx-adm 2>/dev/null || true
    chmod 755 /etc/nginx-adm 2>/dev/null || true

    info "nginx-adm user (UID/GID 1999) configured with home /etc/nginx-adm."
}

# =============================================================================
# setup_nginx_adm_ownership() - Set ownership and symlinks (Fixed for 1.9.0)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF nginx-adm LEAST-PRIVILEGE MODEL
#
# Purpose:
#   Ensures nginx-adm owns the configuration and sets up correct symlinks:
#     /etc/nginx/sites-available  → symlink to /etc/nginx-adm/sites-available
#     /etc/nginx/sites-enabled    → symlink to /etc/nginx-adm/sites-enabled
#
# Important Rules:
#   • Does NOT recreate user (only ownership and symlinks)
#   • Real directories live under /etc/nginx/ (never delete them)
#   • Only create symlinks in /etc/nginx-adm/ if they don't exist or are broken
#   • Preserves existing files in /etc/nginx-adm when user is recreated
#   • Never need to create /etc/nginx-adm (which is the home directory of user: nginx-adm)
#   • Correct symlink direction: /etc/nginx/sites-* → /etc/nginx-adm/sites-*
#   • Never rm -rf real config directories
#   • Ownership: nginx-adm:root (as per your test)
#   • Permissions: 775 for practical group access
#   • not working in /bin/sh mkdir -p /etc/nginx/{sites-available,sites-enabled}
#
# !!! MUST BE CALLED AFTER create_nginx_adm_user() !!!
# =============================================================================

setup_nginx_adm_ownership() {
    info "Setting nginx-adm ownership and symlinks..."

    # 1. Ensure real directories exist under nginx (never delete content)
    # Under /bin/sh, the following is not working, you should do it one by one
    # mkdir -p /etc/nginx/{sites-available,sites-enabled}
    mkdir -p /etc/nginx/sites-available
    mkdir -p /etc/nginx/sites-enabled


    # 3. Transfer ownership
    chown -R nginx-adm:root /etc/nginx 2>/dev/null || true

    # 4. Create symlinks in /etc/nginx/ pointing to /etc/nginx-adm/ (correct direction)
    for dir in sites-available sites-enabled; do
        local source="/etc/nginx/${dir}"
        local target="/etc/nginx-adm/${dir}"

        # If the target is NOT already a symlink to the correct location, fix it
        if [ ! -L "${target}" ] || [ "$(readlink "${target}")" != "${source}" ]; then

            # If it's a real directory, back it up first (safety)
            if [ -d "${target}" ] && [ ! -L "${target}" ]; then
                local today=$(date +%Y%m%d)
                local count=1
                while [ -f "${target}.${today}-${count}.bak" ]; do
                    count=$((count + 1))
                done
                cp -a "${target}" "${target}.${today}-${count}.bak" 2>/dev/null || true
                info "Backed up real directory ${target} before creating symlink."
                rm -rf "${target}" 2>/dev/null || true
            fi

            ln -sf "${source}" "${target}"
            info "Created/updated symlink: ${target} → ${source}"
        fi
    done

    # 5. Set permissions
    chmod 775 /etc/nginx 2>/dev/null || true
    chmod 775 /etc/nginx-adm/sites-available 2>/dev/null || true
    chmod 775 /etc/nginx-adm/sites-enabled 2>/dev/null || true

    success "nginx-adm ownership and correct symlinks configured."
}

# =============================================================================
# setup_restricted_sudoers() - Create restricted sudoers for nginx-adm (NEW 1.9.0)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF nginx-adm LEAST-PRIVILEGE MODEL
#
# Purpose:
#   Creates or updates the sudoers.d file for nginx-adm with restricted permissions.
#
# New Behavior (as requested):
#   • If /etc/sudoers.d/nginx-adm already exists, it is backed up to /etc/sudoers.bak/
#     using dated format: nginx-adm.YYYYMMDD-N.bak (N increments per day)
#   • Creates the backup directory if it doesn't exist
#   • Always writes fresh, clean sudoers content after backup
#   • Validates syntax with visudo when possible
#   • File must end with a blank line (sudoers requirement)
#
# !!! MUST BE CALLED AFTER create_nginx_adm_user() !!!
# =============================================================================

setup_restricted_sudoers() {
    local sudoers_file="/etc/sudoers.d/nginx-adm"
    local backup_dir="/etc/sudoers.bak"

    info "Setting up restricted sudoers for nginx-adm..."

    # Create backup directory if it doesn't exist
    mkdir -p "${backup_dir}" 2>/dev/null || true
    chmod 755 "${backup_dir}" 2>/dev/null || true

    # Backup existing sudoers file if it exists
    if [ -f "${sudoers_file}" ]; then
        local today
        today=$(date +%Y%m%d)

        # Find next backup number for today
        local count=1
        while [ -f "${backup_dir}/nginx-adm.${today}-${count}.bak" ]; do
            count=$((count + 1))
        done

        local backup_file="${backup_dir}/nginx-adm.${today}-${count}.bak"

        cp -a "${sudoers_file}" "${backup_file}" 2>/dev/null || true
        info "Backed up existing sudoers file → ${backup_file}"
    fi

    # Write the new restricted sudoers file (remember leave a blank line at the end)
    cat > "${sudoers_file}" << 'EOF'
# nginx-adm restricted sudoers - gitlab-nginx
# Allows nginx-adm to control nginx service without password (least privilege)
nginx-adm ALL=(ALL) NOPASSWD: /bin/systemctl start nginx
nginx-adm ALL=(ALL) NOPASSWD: /bin/systemctl stop nginx
nginx-adm ALL=(ALL) NOPASSWD: /bin/systemctl reload nginx
nginx-adm ALL=(ALL) NOPASSWD: /bin/systemctl restart nginx
nginx-adm ALL=(ALL) NOPASSWD: /bin/systemctl restart nginx
nginx-adm ALL=(ALL) NOPASSWD: /bin/journalctl -u nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/systemctl start nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/systemctl reload nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u nginx
nginx-adm ALL=(ALL) NOPASSWD: /usr/sbin/nginx

EOF

    chmod 0440 "${sudoers_file}" 2>/dev/null || true
    chown root:root "${sudoers_file}" 2>/dev/null || true

    # Defensive syntax validation
    if command -v visudo >/dev/null 2>&1; then
        if ! visudo -cf "${sudoers_file}" >/dev/null 2>&1; then
            warn "Warning: sudoers file syntax check failed. Please review ${sudoers_file}"
        fi
    fi

    success "Restricted sudoers for nginx-adm configured successfully."
}

# =============================================================================
# backup_existing_nginx_configs() - Dated Backup for nginx and gitlab.rb
# =============================================================================
#
# CRITICAL FUNCTION - PART OF BACKUP POLICY (Updated for v2.0.0)
#
# Purpose:
#   Creates dated backups before modifying any nginx configuration or gitlab.rb.
#   Now supports both nginx configs and gitlab.rb with the exact same policy.
#
# Backup format: <filename>.YYYYMMDD-N.bak
#   Example: default.conf.20260408-1.bak or gitlab.rb.20260408-1.bak
#
# Rules This Function Must Always Follow:
#   • MUST be called before any modification to nginx configs or gitlab.rb
#   • Special rule for default.conf: backup then remove original
#   • gitlab.rb follows identical dated backup rules
#   • All backups created before any removal or symlink changes
#   • Defensive: create backup directories if missing
#   • Ownership set to nginx-adm where appropriate
#
# !!! THIS FUNCTION IS PART OF THE SINGLE SOURCE OF TRUTH FOR BACKUP POLICY !!!
# !!! DO NOT MODIFY OR SIMPLIFY THE BACKUP LOGIC !!!
# =============================================================================

backup_existing_nginx_configs() {
    local sites_dir="/etc/nginx/sites-available"
    local today
    today=$(date +%Y%m%d)

    info "Creating dated backups of existing configurations..."

    # Backup nginx configs
    if [ -d "$sites_dir" ]; then
        for conf in "$sites_dir"/*.conf; do
            [ ! -f "$conf" ] && continue

            local base_name
            base_name=$(basename "$conf")

            # Count existing backups for today
            local count=1
            while [ -f "${conf}.${today}-${count}.bak" ]; do
                count=$((count + 1))
            done

            local backup_file="${conf}.${today}-${count}.bak"

            cp -a "$conf" "$backup_file" 2>/dev/null || true
            chown nginx-adm:nginx-adm "$backup_file" 2>/dev/null || true

            info "Backed up: ${base_name} → ${backup_file}"

            # Special rule for default.conf
            if [ "$base_name" = "default.conf" ] || echo "$base_name" | grep -qE '^default'; then
                rm -f "$conf" 2>/dev/null || true
                info "Removed original default.conf after backup (per policy)."
            fi
        done
    fi

    # Backup gitlab.rb if it exists
    backup_gitlab_rb

    success "Configuration backup completed (nginx + gitlab.rb)."
}

# =============================================================================
# ensure_gitlab_structure() - Defensive Directory & File Pre-Creation for GitLab
# =============================================================================
#
# CRITICAL DEFENSIVE FUNCTION - DO NOT SIMPLIFY, REMOVE, OR REFACTOR
#
# Purpose:
#   This function enforces the "Defensive Pre-Creation Rule" for GitLab.
#   It MUST be called early in every major code path that touches GitLab
#   configuration (install_gitlab_ce, configure_gitlab_rb, backup_gitlab_rb, etc.).
#
# Rules This Function Must Always Follow:
#   • NEVER assume that /etc/gitlab or its files exist.
#   • ALWAYS create the directory structure if missing.
#   • Create placeholder files if needed (e.g. for future gitlab.rb).
#   • Use strict permissions: gitlab.rb should be 600 when written.
#   • This function is intentionally called redundantly for maximum safety.
#
# Why This Function Exists:
#   - GitLab Omnibus may not have created these paths yet.
#   - The script must survive fresh systems, partial installs, or interrupted runs.
#   - It supports independent GitLab handling before reconfigure.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# !!! CALL IT EARLY AND OFTEN !!!
# =============================================================================

ensure_gitlab_structure() {
    if [ "$(id -u)" -ne 0 ]; then
        return 0
    fi

    mkdir -p /etc/gitlab 2>/dev/null || true

    # Create placeholder gitlab.rb if it doesn't exist (defensive)
    if [ ! -f "/etc/gitlab/gitlab.rb" ]; then
        touch "/etc/gitlab/gitlab.rb" 2>/dev/null || true
        chmod 600 "/etc/gitlab/gitlab.rb" 2>/dev/null || true
    fi

    # Ensure logs and other common dirs exist
    mkdir -p /var/log/gitlab 2>/dev/null || true
    mkdir -p /var/opt/gitlab 2>/dev/null || true

    # Defensive ownership - let nginx-adm own config where appropriate
    chown -R nginx-adm:root /etc/gitlab 2>/dev/null || true
}

# =============================================================================
# detect_external_ip() - Get public external IPv4 address
# =============================================================================
#
# GENERAL PURPOSE:
# Returns the machine's public IPv4 address by querying reliable external services.
# Never returns IPv6 addresses. Used for diagnostics and SSH hostname guidance.
#
# Defensive Rules:
#   • Force IPv4 only (-4 flag)
#   • Multiple fallback services
#   • Reject anything that looks like IPv6
#   • Graceful fallback with warning if detection fails
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# =============================================================================

detect_external_ip() {
    local ip

    # Force IPv4-only on every request to prevent IPv6 leakage
    ip=$(curl -4 -fsSL https://ifconfig.me 2>/dev/null || \
         curl -4 -fsSL https://api.ipify.org 2>/dev/null || \
         curl -4 -fsSL https://ipinfo.io/ip 2>/dev/null || \
         echo "")

    # Extra defensive layer: reject IPv6 or empty result
    if echo "$ip" | grep -q ':' || [ -z "$ip" ]; then
        if [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            warn "Could not detect external IPv4 address automatically."
            warn "Please provide SSH hostname manually if needed."
        fi
        echo ""
        return 0
    fi

    echo "$ip"
}

# =============================================================================
# get_or_set_gitlab_ssh_hostname() - Handle GitLab SSH Server Name (Step 8)
# =============================================================================
#
# CRITICAL INTERACTIVE FUNCTION - PART OF THE STRICT 13-STEP SEQUENCE
#
# Purpose:
#   Step 8: Ask user whether to use the main domain as GitLab SSH hostname
#   or provide a custom one (to solve Cloudflare port 22 proxy limitation).
#
#   Saves persistently to /etc/letsencrypt/gitlab-ssh-hostname.conf
#
# Defensive Rules:
#   • ALWAYS call ensure_letsencrypt_structure() first
#   • Default = main domain (user can override)
#   • Input cleaning and validation
#   • Non-interactive mode: fail with clear error
#   • Persistent storage for future runs and nginx-conf regeneration
#
# !!! THIS FUNCTION MUST BE CALLED IN Step 8 !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

get_or_set_gitlab_ssh_hostname() {
    ensure_letsencrypt_structure

    local ssh_file="/etc/letsencrypt/gitlab-ssh-hostname.conf"
    local ssh_hostname=""

    # Check for existing saved SSH hostname
    if [ -f "$ssh_file" ] && [ -s "$ssh_file" ]; then
        ssh_hostname=$(tr -d ' \t\n\r' < "$ssh_file")
        if [ -n "$ssh_hostname" ]; then
            ui_info "Using saved GitLab SSH hostname: ${ssh_hostname}"
            echo "$ssh_hostname"
            return 0
        fi
    fi

    # Non-interactive mode: must already be configured
    if [ "$TTY" = "0" ]; then
        die "No GitLab SSH hostname configured in ${ssh_file}. Please run interactively first."
    fi

    ui_empty_line
    ui_info "GitLab SSH Server Name Configuration (Step 8)"
    ui_warn "Cloudflare does not proxy port 22. If your main domain is behind Cloudflare proxy,"
    ui_warn "you should use a separate SSH hostname (DNS Only / grey cloud)."

    local use_main="y"
    read -rp "Use main domain (${main_domain}) as SSH hostname? (Y/n): " use_main
    use_main=$(echo "$use_main" | tr '[:upper:]' '[:lower:]')

    if [ "$use_main" = "n" ] || [ "$use_main" = "no" ]; then
        while true; do
            read -rp "Enter custom SSH hostname (e.g. ssh.${main_domain}): " ssh_hostname
            ssh_hostname=$(echo "$ssh_hostname" | tr -dc 'a-zA-Z0-9.-' | tr '[:upper:]' '[:lower:]')
            if [ -n "$ssh_hostname" ]; then
                break
            fi
            ui_warn "SSH hostname cannot be empty."
        done
    else
        ssh_hostname="${main_domain}"
    fi

    # Save persistently
    echo "$ssh_hostname" > "$ssh_file"
    chmod 600 "$ssh_file" 2>/dev/null || true

    ui_success "GitLab SSH hostname set to: ${ssh_hostname}"
    echo "$ssh_hostname"
}

# =============================================================================
# write_file_atomic() - Atomic File Writing
# =============================================================================
#
# GENERAL PURPOSE:
# Write file safely using temporary file + atomic move.
# Prevents partial writes on crash or power loss.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Critical for writing gitlab.rb and other config files safely.
# =============================================================================

write_file_atomic() {
    local target="$1"
    local tmp

    tmp=$(mktemp "${target}.XXXXXXXX") || {
        die "Failed to create temporary file for atomic write"
    }

    cat > "${tmp}" || {
        rm -f "${tmp}"
        die "Failed to write content to temporary file"
    }

    mv "${tmp}" "${target}" || {
        rm -f "${tmp}"
        die "Failed to atomically move file to ${target}"
    }
}

# =============================================================================
# backup_gitlab_rb() - Dated Backup for gitlab.rb (Step 9)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF BACKUP POLICY
#
# Purpose:
#   Creates dated backup of /etc/gitlab/gitlab.rb before any modification.
#   Uses the exact same backup format as nginx configs.
#
# Backup format: gitlab.rb.YYYYMMDD-N.bak   (N increments per day)
#
# Rules:
#   • MUST be called before configure_gitlab_rb()
#   • Follows identical policy as backup_existing_nginx_configs()
#   • Defensive: create backup directory if missing
#
# !!! MUST BE CALLED IN Step 9 !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

backup_gitlab_rb() {
    local rb_file="/etc/gitlab/gitlab.rb"
    local backup_dir="/etc/gitlab/backups"
    local today
    today=$(date +%Y%m%d)

    [ ! -f "$rb_file" ] && return 0

    info "Creating dated backup of gitlab.rb..."

    # Create backup directory
    mkdir -p "${backup_dir}" 2>/dev/null || true

    # Count existing backups for today
    local count=1
    while [ -f "${rb_file}.${today}-${count}.bak" ]; do
        count=$((count + 1))
    done

    local backup_file="${rb_file}.${today}-${count}.bak"

    cp -a "$rb_file" "$backup_file" 2>/dev/null || true
    chown nginx-adm:root "$backup_file" 2>/dev/null || true

    info "Backed up: gitlab.rb → ${backup_file}"

    success "GitLab configuration backup completed."
}

# =============================================================================
# install_gitlab_ce() - Install GitLab CE Omnibus (Step 6)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF THE STRICT 13-STEP SEQUENCE
#
# Purpose:
#   Step 6: Install official GitLab CE (Omnibus package) **without** any
#   configuration or reconfigure. This keeps the sequence clean.
#
# Defensive Rules:
#   • Primarily targets Debian/Ubuntu (official GitLab apt repo)
#   • Installs gitlab-ce package only (no automatic reconfigure)
#   • Calls ensure_gitlab_structure() early
#   • Graceful warnings on unsupported platforms
#   • Idempotent: does nothing if gitlab-ce is already installed
#
# !!! THIS FUNCTION MUST REMAIN IN Step 6 !!!
# !!! DO NOT RUN gitlab-ctl reconfigure HERE !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

install_gitlab_ce() {
    if command -v gitlab-ctl >/dev/null 2>&1; then
        info "GitLab CE is already installed."
        return 0
    fi

    info "GitLab CE not found → attempting installation (Step 6)..."

    ensure_gitlab_structure

    # Detect platform
    local OS
    OS=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')

    case "$OS" in
        linux*)
            if command -v apt-get >/dev/null 2>&1; then
                info "Debian/Ubuntu detected → setting up official GitLab repository..."

                # Official GitLab repository setup
                curl -fsSL https://packages.gitlab.com/install/repositories/gitlab/gitlab-ce/script.deb.sh | bash || \
                    die "Failed to setup GitLab CE repository"

                apt-get update -qq || warn "apt-get update failed (continuing)"

                info "Installing gitlab-ce package..."
                apt-get install -y gitlab-ce || die "Failed to install gitlab-ce package."

                success "GitLab CE installed successfully (without configuration)."
                return 0
            else
                die "GitLab CE installation is currently supported only on Debian/Ubuntu. Please install manually on this platform."
            fi
            ;;

        *)
            warn "GitLab CE Omnibus installation on ${OS} is not fully supported."
            die "Recommended: Use Debian/Ubuntu or WSL2 for full compatibility."
            ;;
    esac
}

# =============================================================================
# stop_gitlab_early() - Stop GitLab Services (Step 7)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF THE STRICT 13-STEP SEQUENCE
#
# Purpose:
#   Step 7: Ensure GitLab is completely stopped after package installation.
#   Prevents GitLab from running with default or incomplete configuration.
#
# Defensive Rules:
#   • Uses gitlab-ctl stop if available
#   • Graceful fallback if gitlab-ctl is not yet present
#   • Short sleep to allow services to release ports
#   • Called redundantly for safety
#
# !!! THIS FUNCTION MUST REMAIN IN Step 7 !!!
# !!! DO NOT START GITLAB BEFORE STEP 10 !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

stop_gitlab_early() {
    info "Stopping GitLab services early (Step 7)..."

    if command -v gitlab-ctl >/dev/null 2>&1; then
        gitlab-ctl stop 2>/dev/null || true
        info "GitLab services stopped via gitlab-ctl."
    else
        info "gitlab-ctl not found yet (normal during initial install)."
    fi

    # Additional safety: stop related systemd services if they exist
    systemctl stop gitlab-runsvdir 2>/dev/null || true
    systemctl stop gitlab 2>/dev/null || true

    sleep 3

    info "GitLab services cleared."
}

# =============================================================================
# configure_gitlab_rb() - Configure gitlab.rb (Step 10)
# =============================================================================
#
# CRITICAL FUNCTION - PART OF THE STRICT 13-STEP SEQUENCE
#
# Purpose:
#   Step 10: Write /etc/gitlab/gitlab.rb with external nginx settings,
#   main domain (as external_url with https), and custom SSH hostname.
#
#   Then run `gitlab-ctl reconfigure` if gitlab-ctl exists.
#
# Defensive Rules:
#   • ALWAYS call backup_gitlab_rb() first
#   • ALWAYS call ensure_gitlab_structure() first
#   • Use write_file_atomic() for safe writing
#   • External nginx mode: nginx['enable'] = false
#   • web_server['external_users'] = ['www-data']
#   • Do not start services here — start only in Step 12 via nginx
#
# !!! THIS FUNCTION MUST BE CALLED ONLY AFTER CERTIFICATES ARE ISSUED !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

configure_gitlab_rb() {
    local main_domain="$1"
    local ssh_hostname="$2"

    [ -z "$main_domain" ]   && die "No main domain provided to configure_gitlab_rb()"
    [ -z "$ssh_hostname" ]  && die "No SSH hostname provided to configure_gitlab_rb()"

    backup_gitlab_rb
    ensure_gitlab_structure

    info "Configuring gitlab.rb with external nginx mode (Step 10)..."

    write_file_atomic "/etc/gitlab/gitlab.rb" <<EOF
# gitlab-nginx generated configuration - external nginx mode
external_url 'https://${main_domain}'

# SSH Settings
gitlab_rails['gitlab_ssh_host'] = '${ssh_hostname}'
gitlab_shell['ssh_port'] = 22

# External nginx mode - disable bundled nginx
nginx['enable'] = false
nginx['listen_port'] = 80
nginx['listen_https'] = false

# External web server user (nginx)
web_server['external_users'] = ['www-data']

# Puma / Workhorse settings for external proxy
puma['enable'] = true
puma['worker_processes'] = 2
puma['min_threads'] = 4
puma['max_threads'] = 8

# Disable unnecessary services when using external nginx
gitlab_workhorse['enable'] = true

# Basic settings
gitlab_rails['time_zone'] = 'UTC'
EOF

    success "gitlab.rb configured with external_url https://${main_domain}"
    success "GitLab SSH hostname set to: ${ssh_hostname}"

    # Run reconfigure only if gitlab-ctl exists
    if command -v gitlab-ctl >/dev/null 2>&1; then
        info "Running gitlab-ctl reconfigure..."
        gitlab-ctl reconfigure || warn "gitlab-ctl reconfigure completed with warnings."
        success "GitLab reconfigure completed."
    else
        warn "gitlab-ctl not found. Skipping reconfigure."
    fi
}

# =============================================================================
# show_ssh_config_instructions() - Display Client SSH Configuration (Step 13)
# =============================================================================
#
# CRITICAL FUNCTION - FINAL STEP OF INTERACTIVE SETUP
#
# Purpose:
#   Step 13: Show clear, copy-paste ready instructions for user's client
#   ~/.ssh/config to handle separate SSH hostname (Cloudflare port 22 issue).
#
# Defensive Rules:
#   • Uses ui_msg / ui_info for visibility (stderr)
#   • Shows both main domain and SSH hostname clearly
#   • Explains why separate hostname is needed
#   • Works in both normal and quiet modes (but skipped in --json)
#
# !!! THIS FUNCTION MUST BE CALLED AT THE VERY END OF INTERACTIVE SETUP !!!
# !!! DO NOT MODIFY OR SIMPLIFY !!!
# =============================================================================

show_ssh_config_instructions() {
    local main_domain="$1"
    local ssh_hostname="$2"

    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    ui_empty_line
    double_line
    ui_success "=== GitLab SSH Client Configuration (Step 13) ==="
    ui_empty_line

    ui_warn "Cloudflare does not proxy port 22. To use 'git clone git@${main_domain}:...' "
    ui_warn "you need to map the hostname in your client's ~/.ssh/config."

    ui_empty_line
    ui_msg "Add the following to your local ~/.ssh/config file:"
    ui_empty_line
    ui_msg "Host ${main_domain}"
    ui_msg "    HostName ${ssh_hostname}"
    ui_msg "    Port 22"
    ui_msg "    User git"
    ui_msg "    IdentityFile ~/.ssh/id_rsa   # or your private key"
    ui_empty_line
    ui_info "After adding this, you can use:"
    ui_msg "    git clone git@${main_domain}:group/project.git"
    ui_empty_line

    success "Setup completed successfully."
    info "Your GitLab is now accessible at: https://${main_domain}"
    info "SSH hostname configured as: ${ssh_hostname}"
}

