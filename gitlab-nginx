# =============================================================================
# app_main() - Type 0 + gitlab-nginx domain dispatcher
# =============================================================================
app_main() {
    : "${COMMAND:=help}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${USE_CLOUDFLARE:=1}"
    : "${LPU_REMOVE_TARGET:=all}"

    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # Type O empty argv = install-ensure (not domain run)
    if [ $# -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_perform_install
            exit $?
        elif inst_is_installed; then
            inst_perform_install
            exit $?
        else
            inst_maybe_install
            exit $?
        fi
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force|--reset|--reinstall) FORCE=1; FORCE_REINSTALL=1 ;;
            --no-cloudflare) USE_CLOUDFLARE=0 ;;
            version|about|help|version-check|self-update|self-uninstall|install)
                COMMAND="$1"
                ;;
            run|setup|domains|email|ssh-hostname|nginx-conf)
                COMMAND="$1"
                ;;
            remove-lpu)
                COMMAND="remove-lpu"
                ;;
            remove-nginx-adm)
                COMMAND="remove-lpu"
                LPU_REMOVE_TARGET="nginx"
                ;;
            remove-gitlab-adm)
                COMMAND="remove-lpu"
                LPU_REMOVE_TARGET="gitlab"
                ;;
            nginx|nginx-adm|gitlab|gitlab-adm|all|both)
                if [ "${COMMAND}" = "remove-lpu" ]; then
                    LPU_REMOVE_TARGET="$1"
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
            *)
                out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} cloudflare=${USE_CLOUDFLARE} lpu_target=${LPU_REMOVE_TARGET}"

    case "${COMMAND}" in
        version) app_version ;;
        about) app_about ;;
        version-check) ver_check ;;
        self-update) inst_self_update ;;
        self-uninstall) inst_self_uninstall ;;
        install) inst_perform_install ;;
        run|setup)
            # Domain full setup — root required
            if [ "${TTY:-0}" -eq 1 ]; then
                run_interactive_setup
            else
                run_non_interactive_setup
            fi
            ;;
        domains) show_domains ;;
        email) show_email ;;
        ssh-hostname)
            check_root
            ssh_hostname=$(get_or_set_gitlab_ssh_hostname)
            if [ "${JSON}" -eq 1 ]; then
                domains=$(load_existing_domains)
                main_domain=$(get_main_domain_from_file "$domains")
                out_json "success" "" "ssh_hostname" "$ssh_hostname" "main_domain" "${main_domain}"
            else
                success "GitLab SSH hostname: ${ssh_hostname}"
            fi
            ;;
        nginx-conf)
            check_root
            domains=$(load_existing_domains)
            [ -z "$domains" ] && die "No domains found. Run full setup first (sudo ${APP_NAME} run)."
            main_domain=$(get_main_domain_from_file "$domains")
            [ -z "$main_domain" ] && die "Could not determine main domain."
            backup_nginx_sites_configs
            deploy_domain_nginx_configs "$domains" "$main_domain"
            info "Nginx configs regenerated using main domain: ${main_domain}"
            ;;
        remove-lpu)
            remove_least_privilege_operators
            ;;
        help|*) app_help ;;
    esac
}

