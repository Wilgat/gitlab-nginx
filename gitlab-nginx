# =============================================================================
# deploy_gitlab_nginx_config() - compatibility wrapper (specialize A→B)
# =============================================================================
# Interactive setup historically called deploy_gitlab_nginx_config "$main_domain".
# Canonical implementation is deploy_domain_nginx_configs domains main_domain.
# =============================================================================
deploy_gitlab_nginx_config() {
    local main_domain="${1-}"
    local domains="${2-}"
    # Support both call shapes:
    #   deploy_gitlab_nginx_config "$main_domain"
    #   deploy_gitlab_nginx_config "$domains" "$main_domain"  (legacy nginx-conf)
    if [ -n "${2-}" ]; then
        # two-arg form was (domains, main) in one old path; detect by presence of space in $1
        if echo "$1" | grep -q ' '; then
            domains="$1"
            main_domain="$2"
        else
            # ambiguous: prefer first as main when single token
            main_domain="$1"
            domains="$2"
        fi
    fi
    if [ -z "$domains" ]; then
        domains=$(load_existing_domains)
    fi
    if [ -z "$main_domain" ]; then
        main_domain=$(get_main_domain_from_file "$domains")
    fi
    [ -z "$domains" ] && die "No domains for deploy_gitlab_nginx_config"
    [ -z "$main_domain" ] && die "No main domain for deploy_gitlab_nginx_config"
    deploy_domain_nginx_configs "$domains" "$main_domain"
}

run_interactive_setup() {
    check_root

    # Defensive pre-creation - NEVER assume directories exist
    ensure_letsencrypt_structure
    ensure_gitlab_structure

    # === Least-Privilege Setup (nginx-adm + gitlab-adm) ===
    # These must run very early to establish ownership before any config changes
    create_nginx_adm_user
    setup_nginx_adm_ownership
    setup_restricted_sudoers

    create_gitlab_adm_user
    setup_gitlab_adm_ownership_and_symlinks
    setup_gitlab_restricted_sudoers

    # Step 1-2: Install packages (no configuration yet)
    install_certbot
    install_nginx

    # Step 3: Stop Nginx early (critical for Certbot --standalone)
    stop_nginx_early

    # Step 4: Handle email and domains independently (MUST be done FIRST)
    local email
    email=$(get_or_set_email)

    local main_domain
    local domains
    local domains_to_confirm

    domains=$(load_existing_domains)
    [ -n "$domains" ] && main_domain=$(get_main_domain_from_file "$domains")

    if [ -z "$main_domain" ]; then
        main_domain=$(get_main_domain)
    else
        ui_info "Using saved main domain: ${main_domain}"
    fi

    if [ -n "$domains" ]; then
        domains=$(echo "$domains" | tr ' ' '\n' | grep -v "^$main_domain$" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')
        domains_to_confirm="$main_domain $domains"
        domains_to_confirm=$(echo "$domains_to_confirm" | tr -s ' ' | sed 's/^ *//;s/ *$//')
    else
        domains_to_confirm="$main_domain"
    fi

    domains=$(ask_and_confirm_domains "$domains_to_confirm")

    # Force main domain to front (CRITICAL RULE)
    if [ -n "$main_domain" ] && [ -n "$domains" ]; then
        domains=$(echo "$domains" | tr ' ' '\n' | grep -v "^$main_domain$" | tr '\n' ' ' | sed 's/^ *//;s/ *$//')
        domains="$main_domain $domains"
        domains=$(echo "$domains" | tr -s ' ' | sed 's/^ *//;s/ *$//')
    fi
    save_domains_to_file "$domains"

    # Step 5: Apply certificates (standalone) - BEFORE any GitLab config
    apply_letsencrypt_standalone "$domains" "$email" "$main_domain"

    # Step 6: Install GitLab CE (Omnibus) without configuration
    install_gitlab_ce

    # Step 7: Ensure GitLab is stopped
    stop_gitlab_early

    # Step 8: GitLab SSH hostname (explicitly addresses Cloudflare port 22 limitation)
    local ssh_hostname
    ssh_hostname=$(get_or_set_gitlab_ssh_hostname)

    # Step 9: Backup gitlab.rb before any modification
    backup_gitlab_rb

    # Step 10: Configure gitlab.rb + reconfigure
    configure_gitlab_rb "$main_domain" "$ssh_hostname"

    # Step 11: Setup full Nginx configuration with GitLab proxy
    # (This replaces the old per-domain logic with GitLab-specific block)
    deploy_gitlab_nginx_config "$main_domain"

    # Step 12: Test and start nginx (as nginx-adm - least privilege)
    info "Testing nginx configuration..."
    sudo -u nginx-adm nginx -t || die "Nginx config test failed!"

    info "Starting nginx service..."
    systemctl start nginx || warn "Failed to start nginx (check manually)"

    success "Nginx started successfully."

    # Step 13: Display clear ~/.ssh/config instructions for client machines
    show_ssh_config_instructions "$main_domain" "$ssh_hostname"

    success "Full GitLab + external nginx setup completed successfully."
    success "GitLab is now accessible at: https://${main_domain}"
}


