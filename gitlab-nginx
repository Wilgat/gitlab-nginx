# =============================================================================
# output_text() - SINGLE SOURCE OF TRUTH FOR ALL HUMAN OUTPUT
# =============================================================================
#
# !!! THIS IS THE SINGLE SOURCE OF TRUTH FOR ALL OUTPUT !!!
# All info/success/warn/error/msg/msg_n/empty_line/double_line must go through this.
# Do NOT add direct printf/echo anywhere else in the script.
#
# Behavior:
#   - JSON=1     → output_text() prints NOTHING. Use output_json() instead.
#   - QUIET=1    → output_text() only allows error/die level messages.
#   - Normal mode→ colored text to stdout or stderr as appropriate.
#
# Never use echo. Always use printf.
# This function is intentionally defensive and verbose.
# =============================================================================

detect_nginx_platform_paths() {
    local os_type
    os_type=$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')

    case "$os_type" in
        darwin*)  # macOS
            if [ -d "/opt/homebrew/etc/nginx" ]; then
                NGINX_CONF_ROOT="/opt/homebrew/etc/nginx"
                NGINX_PLATFORM="homebrew-arm"
            elif [ -d "/usr/local/etc/nginx" ]; then
                NGINX_CONF_ROOT="/usr/local/etc/nginx"
                NGINX_PLATFORM="homebrew-intel"
            elif [ -d "/opt/local/etc/nginx" ]; then
                NGINX_CONF_ROOT="/opt/local/etc/nginx"
                NGINX_PLATFORM="macports"
            fi
            ;;
        linux*)
            if command -v apt-get >/dev/null 2>&1; then
                NGINX_PLATFORM="debian"
            elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
                NGINX_PLATFORM="rhel"
            elif command -v apk >/dev/null 2>&1; then
                NGINX_PLATFORM="alpine"
            fi
            ;;
    esac

    # Re-apply paths based on detected root
    NGINX_SITES_AVAILABLE="${NGINX_CONF_ROOT}/sites-available"
    NGINX_SITES_ENABLED="${NGINX_CONF_ROOT}/sites-enabled"
    NGINX_CONF_D="${NGINX_CONF_ROOT}/conf.d"

    if [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
        info "Detected nginx platform: ${NGINX_PLATFORM} (root: ${NGINX_CONF_ROOT})"
    fi
}

# =============================================================================
# show_system_diagnostics() - Full System Diagnostics (nginx-adm + gitlab-adm)
# =============================================================================
#
# CRITICAL DIAGNOSTICS FUNCTION - SINGLE SOURCE OF TRUTH FOR SYSTEM STATUS
#
# Purpose:
#   This is the main diagnostics entry point for the entire gitlab-nginx project.
#   It provides complete visibility into the dual least-privilege model:
#     • Script version and installation status
#     • nginx-adm least-privilege status (for external nginx configuration)
#     • gitlab-adm least-privilege status (for GitLab configuration tree)
#     • Nginx platform detection and current paths
#     • GitLab configuration symlink status (/etc/gitlab → /etc/gitlab-adm/gitlab)
#     • Shell, current user, TTY, and interactive state
#
# Why this name and scope?
#   - Previous name `show_nginx_system_diagnostics` was too narrow after introducing gitlab-adm.
#   - New name clearly communicates that we now manage TWO dedicated least-privilege users:
#     nginx-adm (for external nginx) and gitlab-adm (for GitLab configuration).
#   - This prevents future AI assistants or maintainers from misunderstanding the dual-admin model.
#
# Defensive Design Rules (Strictly Applied):
#   • Always call detect_nginx_platform_paths() safely (idempotent)
#   • Gracefully handle cases where nginx-adm or gitlab-adm do not exist yet
#   • Never assume directories, users, or symlinks exist (defensive pre-creation rule)
#   • Works correctly for both root and non-root users
#   • Fully supports --quiet and --json modes
#   • All output MUST go through the central output_text() / output_json() system
#   • No raw echo, printf, or cat allowed outside approved functions
#
# !!! THIS IS THE MAIN DIAGNOSTICS ENTRY POINT !!!
# !!! DO NOT RENAME WITHOUT EXPLICIT USER INSTRUCTION !!!
# !!! DO NOT REMOVE THE gitlab-adm SECTION !!!
# !!! MUST INCLUDE BOTH LEAST-PRIVILEGE USERS !!!
# !!! CALL IT EARLY AND OFTEN IN FUTURE COMMANDS IF NEEDED !!!
# =============================================================================

show_system_diagnostics() {
    # Defensive: ensure platform detection runs safely (idempotent)
    detect_nginx_platform_paths

    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Rich machine-friendly output ===
        local installed="false"
        is_installed && installed="true"

        local global_ver="not found"
        if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local current_shell="unknown"
        current_shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")
        
        if [ "$current_shell" = "${APP_NAME}" ] || [ "$current_shell" = "sh" ] || \
           [ "$current_shell" = "dash" ] || [ "$current_shell" = "ash" ]; then
            local parent_pid
            parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
            if [ -n "$parent_pid" ]; then
                current_shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$current_shell")
            fi
        fi

        local interactive="false"
        [ -t 1 ] && interactive="true"

        # Check gitlab-adm status
        local gitlab_adm_exists="false"
        id "gitlab-adm" >/dev/null 2>&1 && gitlab_adm_exists="true"

        # Check nginx-adm status
        local nginx_adm_exists="false"
        id "nginx-adm" >/dev/null 2>&1 && nginx_adm_exists="true"

        # Check GitLab symlink status
        local gitlab_symlink_active="false"
        [ -L "/etc/gitlab" ] && gitlab_symlink_active="true"

        output_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "global_version" "${global_ver}" \
            "shell" "${current_shell}" \
            "interactive" "${interactive}" \
            "user" "${USERNAME}" \
            "nginx_platform" "${NGINX_PLATFORM:-unknown}" \
            "nginx_conf_root" "${NGINX_CONF_ROOT}" \
            "nginx_sites_available" "${NGINX_SITES_AVAILABLE}" \
            "nginx_sites_enabled" "${NGINX_SITES_ENABLED}" \
            "nginx_adm_exists" "${nginx_adm_exists}" \
            "gitlab_adm_exists" "${gitlab_adm_exists}" \
            "gitlab_config_symlink" "${gitlab_symlink_active}"

        return 0
    fi

    # === Normal Human-readable Mode ===
    [ "${QUIET}" -eq 1 ] && return 0

    msg "=== ${APP_NAME} ${VERSION} - System Diagnostics ==="
    empty_line

    # Installation status
    if is_installed; then
        success "${APP_NAME} is installed."
    else
        warn "${APP_NAME} is NOT installed."
        msg "   Recommended: curl -fsSL ${SCRIPT_URL} | sudo ${SH}"
    fi

    empty_line

    # Global installation check
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        msg "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${global_ver}"
    else
        msg "Global install  (${GLOBAL_BIN}/${APP_NAME}):   not found"
    fi

    empty_line

    # Shell & Environment
    local current_shell="unknown"
    current_shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")
    
    if [ "$current_shell" = "${APP_NAME}" ] || [ "$current_shell" = "sh" ] || \
       [ "$current_shell" = "dash" ] || [ "$current_shell" = "ash" ]; then
        local parent_pid
        parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$parent_pid" ]; then
            current_shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$current_shell")
        fi
    fi

    msg "Current shell:     ${current_shell}"
    msg "User:              ${USERNAME}"
    msg "TTY / Interactive: $( [ -t 1 ] && echo "yes" || echo "no" )"

    empty_line

    # nginx-adm Least-Privilege Status
    msg "=== nginx-adm Least-Privilege Status ==="
    if id "nginx-adm" >/dev/null 2>&1; then
        success "nginx-adm user exists (UID 1999)"
        msg "   Home directory : /etc/nginx-adm"
        msg "   Owns           : ${NGINX_CONF_ROOT}"
    else
        warn "nginx-adm user does NOT exist yet"
    fi

    empty_line

    # gitlab-adm Least-Privilege Status
    msg "=== gitlab-adm Least-Privilege Status ==="
    if id "gitlab-adm" >/dev/null 2>&1; then
        success "gitlab-adm user exists (UID/GID 1888)"
        msg "   Home directory : /etc/gitlab-adm (preferred-/etc; legacy /home/gitlab-adm may still exist during migrate)"
        if [ -L "/etc/gitlab" ]; then
            success "   /etc/gitlab symlink: active → $(readlink /etc/gitlab 2>/dev/null || echo /etc/gitlab-adm/gitlab)"
        else
            warn "   /etc/gitlab symlink: MISSING or broken"
        fi
    else
        warn "gitlab-adm user does NOT exist yet"
    fi

    empty_line

    # Nginx Platform Detection
    msg "=== Nginx Platform Detection ==="
    msg "Detected Platform : ${NGINX_PLATFORM:-unknown}"
    msg "Config Root       : ${NGINX_CONF_ROOT}"
    msg "Sites Available   : ${NGINX_SITES_AVAILABLE}"
    msg "Sites Enabled     : ${NGINX_SITES_ENABLED}"
    msg "Conf.d directory  : ${NGINX_CONF_D}"

    empty_line
    msg "Use '${APP_NAME} about' to see this information again."
    msg "Run '${APP_NAME} ssh-hostname' to check or change GitLab SSH hostname."
}

