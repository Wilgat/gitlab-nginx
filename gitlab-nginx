# =============================================================================
app_about() {
    : "${APP_NAME:=gitlab-nginx}"
    : "${VERSION:=2.5.3}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${USERNAME:=unknown}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${EFFECTIVE_STORAGE_DIR:=}"
    : "${STORAGE_DIR:=}"
    : "${PERSISTENT_STORAGE_DIR:=}"
    : "${REPO_USER:=Wilgat}"
    : "${REPO_NAME:=gitlab-nginx}"
    : "${SCRIPT_URL:=}"
    : "${DOMAINS_FILE:=/etc/letsencrypt/domains.conf}"
    : "${EMAIL_FILE:=/etc/letsencrypt/email.conf}"

    installed=0
    install_path=""
    if inst_is_installed; then
        installed=1
        install_path=$(util_get_install_bin_path 2>/dev/null || true)
    fi
    local_ver=$(inst_get_version 2>/dev/null || echo "unknown")
    shell_name=$(util_get_current_shell 2>/dev/null || echo "sh")

    domain_count=0
    main_domain=""
    if [ -f "${DOMAINS_FILE}" ]; then
        domain_count=$(grep -cve '^[[:space:]]*$' "${DOMAINS_FILE}" 2>/dev/null || echo 0)
        main_domain=$(awk 'NF {print; exit}' "${DOMAINS_FILE}" 2>/dev/null || true)
    fi
    email_cfg=""
    if [ -f "${EMAIL_FILE}" ]; then
        email_cfg=$(head -n1 "${EMAIL_FILE}" 2>/dev/null || true)
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "$([ "${installed}" -eq 1 ] && echo true || echo false)" \
            "install_path" "${install_path}" \
            "local_version" "${local_ver}" \
            "shell" "${shell_name}" \
            "user" "${USERNAME}" \
            "interactive" "$([ "${TTY:-0}" -eq 1 ] && echo true || echo false)" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "cache_preferred" "$(util_preferred_cache_dir)" \
            "cache_fallback" "$(util_fallback_cache_dir)" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "domains_file" "${DOMAINS_FILE}" \
            "email_file" "${EMAIL_FILE}" \
            "domain_count" "${domain_count}" \
            "main_domain" "${main_domain}" \
            "email" "${email_cfg}" \
            "domain" "gitlab-nginx"
        return 0
    fi

    out_double_line
    out_info "${APP_NAME} about"
    out_plain "Version:        ${VERSION}"
    out_plain "Installed:      $([ "${installed}" -eq 1 ] && echo yes || echo no) ${install_path}"
    out_plain "Local version:  ${local_ver}"
    out_plain "Shell:          ${shell_name}"
    out_plain "User:           ${USERNAME}"
    out_plain "Channel:        ${SCRIPT_URL}"
    out_plain "Cache folder (preferred): $(util_preferred_cache_dir)"
    out_plain "Cache folder (fallback):  $(util_fallback_cache_dir)"
    out_plain "Persistence folder:       ${PERSISTENT_STORAGE_DIR}"
    out_empty_line
    out_info "Domain (GitLab + external Nginx)"
    out_plain "Domains file:   ${DOMAINS_FILE} (count=${domain_count})"
    out_plain "Main domain:    ${main_domain:-"(not configured)"}"
    out_plain "Email file:     ${EMAIL_FILE}"
    out_plain "Email:          ${email_cfg:-"(not configured)"}"
    out_empty_line
    out_info "Useful commands:"
    out_plain "  sudo ${APP_NAME} run          Full interactive setup (root)"
    out_plain "  sudo ${APP_NAME} domains      Show saved domains"
    out_plain "  sudo ${APP_NAME} email        Show saved email"
    out_plain "  sudo ${APP_NAME} nginx-conf   Regenerate Nginx configs"
    out_plain "  ${APP_NAME} help              Full usage"
    out_plain "  ${APP_NAME} self-update       Update CLI"
    out_double_line
}

app_version() {
    : "${APP_NAME:=gitlab-nginx}"
