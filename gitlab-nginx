    echo "$domains" | awk '{print $1}'
}


# =============================================================================
# display_current_domains() - Show Current Domains During Interactive Confirmation
# =============================================================================
#
# Purpose:
#   Displays the current list of domains to the user during the interactive
#   confirmation step inside ask_and_confirm_domains().
#
#   This is a helper function used ONLY for user interaction, not for general
#   display (use show_domains() for that).
#
# Rules This Function Must Follow:
#   • Must respect --quiet and --json modes (should do nothing in those modes).
#   • Must use the central output system (msg(), empty_line(), etc.).
#   • Clearly indicate the total count of domains.
#   • Output should be clean and readable during interactive prompts.
#   • The first domain will later become the Primary/Main domain.
#   • Prints ALL output to stderr so it is never captured by command substitution.
#
# Important:
#   This function is called repeatedly during domain confirmation loop.
#   It should remain lightweight and user-friendly.
#
# !!! DO NOT USE RAW echo OR >&2 REDIRECTION !!!
# !!! ALL OUTPUT MUST GO THROUGH output_text() WRAPPERS !!!
# =============================================================================

display_current_domains() {
    local domains="$1"

    # Respect quiet and json modes
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    local count
    count=$(echo "$domains" | wc -w | tr -d ' ')

    ui_empty_line
    ui_msg "=== Current domains (${count} total) ==="

    if [ -n "$domains" ] && [ "$domains" != "" ]; then
        for d in $domains; do
            ui_msg " - ${d}"
        done
